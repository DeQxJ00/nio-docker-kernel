# Rootful Docker compatibility overlay for Motorola nio (merged last)
# Keep source Qualcomm/Motorola defconfigs unchanged.
# FANOTIFY omitted: source fanotify.c has an undeclared old_memcg in this branch.
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CFS_BANDWIDTH=y
