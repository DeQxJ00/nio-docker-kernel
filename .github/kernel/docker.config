# Docker/container runtime additions derived from the checked-in final.config.
# Device-specific options stay in LineageOS' upstream nio-default.config.
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_RD_XZ=y
CONFIG_HARDEN_BRANCH_PREDICTOR=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_USB_UAS=y
CONFIG_USB_F_ACM=y
CONFIG_USB_U_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_ION_SYSTEM_HEAP=y
CONFIG_QCA_CLD_WLAN=m
CONFIG_MMI_DEVICE_DTBS=y
CONFIG_NIO_DTB=y
CONFIG_MOTO_F_USBNET=m
CONFIG_MMI_ANNOTATE=m
CONFIG_MMI_INFO=m
CONFIG_MMI_RELAY=m
CONFIG_TZLOG_DUMP=m
CONFIG_WATCHDOG_CPU_CTX=m
CONFIG_WATCHDOGTEST=m
CONFIG_EXFAT_FS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

